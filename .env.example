# Helm OCI registry settings (used by Taskfile and CI)
# Example:
#   OCI_REPO=registry.gitlab.com/from-the-lamp/infra/helm-charts
#   OCI_REPO_USER=<gitlab-registry-user>
#   OCI_REPO_PASS=<gitlab-registry-token>
OCI_REPO=
# Dev-iteration registry for `task dev:*` targets (same shape as docker-images/
# terraform-modules). Deliberately set equal to OCI_REPO for now - there is no
# separate dev chart registry yet, so `task dev:build:push:changed` republishes
# to the SAME registry as a normal release until a real dev registry exists.
OCI_REPO_DEV=
OCI_REPO_USER=
OCI_REPO_PASS=
